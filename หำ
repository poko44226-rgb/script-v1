track(R.Heartbeat:Connect(function(dt)
	if not(isA or isS)then return end
	tm=tm+dt;if tm<.033 then return end;tm=0
	local currentTarget = targetPlayer or lp
	local c,tot=currentTarget.Character, #rem
	local hrp=c and c:FindFirstChild("HumanoidRootPart")
	if not hrp or tot==0 then return end
	rp.FilterDescendantsInstances={c,W:FindFirstChild("WorkspaceCom")}
	if isS then
		local h,e=math.ceil(tot/2),1+.35*math.sin(tick()*8)
		for i,r in ipairs(rem)do if r and r.Parent and r.Parent.Parent then
			local isL,sub=i<=h,i<=h and i or(i-h);local mS=isL and h or(tot-h)
			local a=((mS>1 and(sub-1)/(mS-1)or.5)-.5)*math.pi
			local wp=hrp.CFrame:PointToWorldSpace(Vector3.new((1.2*e+math.cos(a)*2.2*e)*(isL and -1 or 1),math.sin(a)*(mS*1.1),-4))
			task.spawn(pcall,function()r:InvokeServer(CFrame.new(wp,wp+hrp.CFrame.LookVector))end)
		end end
	else
		local pS=isP and(.55+.45*math.sin(tick()*12))or 1
		for i,r in ipairs(rem)do if r and r.Parent and r.Parent.Parent then
			local cf
			if i<=2 and tot>=3 then local wp=hrp.CFrame:PointToWorldSpace(Vector3.new((i==2 and 1 or -1)*2.5,-.5,-5));cf=CFrame.new(wp,wp+hrp.CFrame.LookVector)*RH;cfSt[i]=cf
			else
				local ai=i-2;local bP=hrp.CFrame:PointToWorldSpace(Vector3.new(0,-math.pow(ai*.35,1.3)*pS,-5-(ai-1)*2*pS))
				local ry=W:Raycast(bP+Vector3.new(0,10,0),Vector3.new(0,-20,0),rp)
				local fP=(ry and bP.Y<ry.Position.Y+1.2)and Vector3.new(bP.X,ry.Position.Y+1.2,bP.Z)or bP
				local raw=CFrame.new(fP,fP+hrp.CFrame.LookVector)*RH
				cfSt[i]=cfSt[i]and cfSt[i]:Lerp(raw,isP and.5 or math.clamp(.45-ai*.04,.15,.45))or raw;cf=cfSt[i]
			end
			if cf then task.spawn(pcall,function()r:InvokeServer(cf)end)end
		end end
	end
end))
