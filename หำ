local function findPlayer(name)
	if not name or name=="" then return nil end
	name=name:lower()
	for _,plr in ipairs(P:GetPlayers())do
		if plr~=lp and (plr.Name:lower():sub(1,#name)==name or (plr.DisplayName and plr.DisplayName:lower():sub(1,#name)==name)) then
			return plr
		end
	end
	return nil
end

-- คลิกที่ช่องซ้ำ เพื่อเคลียร์ชื่อและรีเซ็ตเป้าหมายกลับมาที่ตัวเรา
track(tBox.Focused:Connect(function()
	if targetPlayer~=nil or tBox.Text~="" then
		targetPlayer=nil
		tBox.Text=""
	end
end))

-- กด Enter (ตกลง) เพื่อยืนยันเปลี่ยนเป้าหมาย
track(tBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		local txt=tBox.Text
		if txt=="" then
			targetPlayer=nil
		else
			local found=findPlayer(txt)
			if found then
				targetPlayer=found
				tBox.Text=found.Name
			else
				targetPlayer=nil
				tBox.Text="[Not Found]"
				task.wait(1)
				if targetPlayer==nil then tBox.Text="" end
			end
		end
	end
end))

local function sV(b,s,st,t,cO,cS)
	b.Text=t..(st and"ON"or"OFF")
	T:Create(b,TweenInfo.new(.25),{BackgroundColor3=st and cO or Color3.fromRGB(45,45,45)}):Play()
	T:Create(s,TweenInfo.new(.25),{Color=st and cS or Color3.fromRGB(230,50,50)}):Play()
end

