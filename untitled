                        if crR then
                            pcall(function()
                                crR:InvokeServer(getThemeColor(t, i))
                            end)
                        end
                    end
                end)
            end
        end

        if canUpdateColor then
            colorIndex = (colorIndex % totalProps) + 1
            lastColorUpdate = t
        end
        lastNetworkUpdate = t
    end
end)