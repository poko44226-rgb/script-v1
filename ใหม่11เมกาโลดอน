-- relasi dihitung dari posisi idle, lalu diterapkan ke walk1 & walk2 slot 34.
do
    local rel = propdata[34].cf:Inverse() * propdata[25].cf
    Walk1Data[25] = { cf = Walk1Data[34].cf * rel }
    Walk2Data[25] = { cf = Walk2Data[34].cf * rel }
end

local TOTAL = #propdata
if #Walk1Data ~= TOTAL or #Walk2Data ~= TOTAL then
    warn("[Megalodon] jumlah pose beda: idle=" .. TOTAL .. " walk1=" .. #Walk1Data .. " walk2=" .. #Walk2Data)
end

-- deteksi pose aneh: kalo ada prop yang rotasi idle<->walk beda lebih dari 80 deg, kemungkinan data wrap / salah record
do
    local function rotDiff(a, b)
        local dot = a.LookVector:Dot(b.LookVector) + a.UpVector:Dot(b.UpVector) + a.RightVector:Dot(b.RightVector)
        return math.deg(math.acos(math.clamp((dot - 1) / 2, -1, 1)))
    end
    for i = 1, TOTAL do
        local d = math.max(rotDiff(propdata[i].cf, Walk1Data[i].cf), rotDiff(propdata[i].cf, Walk2Data[i].cf))
        if d > 80 then
            warn(string.format("[Megalodon] slot %d (%s) rotasi pose jauh: %.0f deg - kemungkinan data wrap", i, propdata[i].id, d))
        end
    end
end

-- prop putih = ga ganti warna. sisanya ganti otomatis
local CYCLE_SLOT, PHASE = {}, {}
do
    if BODY_Y_OFFSET ~= 0 then
        local shift = CFrame.new(0, BODY_Y_OFFSET, 0)
        for _, set in ipairs({ propdata, Walk1Data, Walk2Data }) do
            for _, d in ipairs(set) do d.cf = shift * d.cf end
        end
    end
    local minZ = math.huge
    for _, d in ipairs(propdata) do minZ = math.min(minZ, d.cf.Z) end
    for i, d in ipairs(propdata) do
        if not isWhite(d.c) then
            CYCLE_SLOT[i] = true
            PHASE[i] = (COLOR_WAVE_STEP > 0) and math.floor((d.cf.Z - minZ) / COLOR_WAVE_STEP) or 0
        end
    end
end

-- ============================================================
-- PROPS
-- ============================================================
local folder = nil
local warnedFolder, warnedNoProp = false, false
local PROP_CACHE      = {}
local SLOT_OF         = setmetatable({}, { __mode = "k" })
local CURRENT_CFRAMES = {}
local LAST_SEND_TIME  = {}
local LAST_SENT_CF    = {}
local REMOTE_CACHE    = {}
local WANT_SIZE       = {}
local WANT_COLOR      = {}
local SIZE_ST         = {}
local COLOR_SENT      = {}
local COLOR_BUSY      = {}
local TEX_SENT        = {}
local TEX_BUSY        = {}
local INFLIGHT        = {}

local function GetFolder()
    if folder and folder.Parent then return folder end
    local wc = workspace:FindFirstChild("WorkspaceCom")
    folder = wc and wc:FindFirstChild("001_TrafficCones")
    return folder
end

local function propInfo(prop)
    local id = prop:GetAttribute("ID") or prop:GetAttribute("id")
    local size = (prop:IsA("BasePart") and prop.Size)
        or (prop:IsA("Model") and prop:GetExtentsSize()) or nil
    return id, size
end

local function releaseSlot(slot)
    PROP_CACHE[slot], CURRENT_CFRAMES[slot], LAST_SEND_TIME[slot] = nil, nil, nil
    LAST_SENT_CF[slot], REMOTE_CACHE[slot] = nil, nil
    WANT_SIZE[slot], WANT_COLOR[slot], SIZE_ST[slot] = nil, nil, nil
    COLOR_SENT[slot], COLOR_BUSY[slot] = nil, nil
    TEX_SENT[slot], TEX_BUSY[slot] = nil, nil
    INFLIGHT[slot] = nil
end

local function UpdateProps()
    local f = GetFolder()
    if not f then
        if not warnedFolder then
            warnedFolder = true
            warn("[Megalodon] folder Workspace.WorkspaceCom.001_TrafficCones ga ketemu")
        end
        return
    end
    local exactName = "Prop" .. OwnerName

    for slot = 1, TOTAL do
        local p = PROP_CACHE[slot]
        if p and not p.Parent then
            SLOT_OF[p] = nil
            releaseSlot(slot)
        end
    end

    local exactAll, fresh, loose = 0, {}, {}
    for _, v in ipairs(f:GetChildren()) do
        if v.Name == exactName then
            exactAll += 1
            if not SLOT_OF[v] then fresh[#fresh + 1] = v end
        elseif not SLOT_OF[v] and v.Name:find(OwnerName, 1, true) then
            loose[#loose + 1] = v
        end
    end
    if exactAll == 0 then fresh = loose end   -- fallback: nama yang MENGANDUNG nama player
    if #fresh == 0 then return end

    for pass = 1, 2 do
        for _, prop in ipairs(fresh) do
            if not SLOT_OF[prop] then
                local id, size = propInfo(prop)
                if id then
                    for slot = 1, TOTAL do
                        local d = propdata[slot]
                        if not PROP_CACHE[slot] and d.id == id
                            and (pass == 2 or (size and (size - d.size).Magnitude < 0.1)) then
                            PROP_CACHE[slot] = prop
                            SLOT_OF[prop] = slot
                            LAST_SEND_TIME[slot] = os.clock() - BASE_TICK_RATE
                            WANT_SIZE[slot]  = d.size
                            WANT_COLOR[slot] = d.c
                            SIZE_ST[slot] = { scale = 1, tries = 0, at = 0, warned = false }
                            break
                        end
                    end
                end
            end
        end
    end
end

-- ============================================================
-- SIZE (closed-loop SetCurrentScale)
-- ============================================================
local lastSizeTick = 0
local function processSizes(now)
    if now - lastSizeTick < 0.2 then return end
    lastSizeTick = now
    local budget = SIZE_BUDGET
    for slot = 1, TOTAL do
        if budget <= 0 then break end
        local prop, want, st = PROP_CACHE[slot], WANT_SIZE[slot], SIZE_ST[slot]
        if prop and prop.Parent and want and st and st.tries < SIZE_MAX_TRIES then
            local _, cur = propInfo(prop)
            if cur and cur.Magnitude > 1e-3 then
                local off = math.max(
                    math.abs(cur.X - want.X) / math.max(want.X, 0.01),
                    math.abs(cur.Y - want.Y) / math.max(want.Y, 0.01),
                    math.abs(cur.Z - want.Z) / math.max(want.Z, 0.01))
                if off < SIZE_TOLERANCE then
                    st.tries = 0
                elseif now - st.at > SIZE_RETRY_DELAY then
                    local rem = prop:FindFirstChild("SetCurrentScale") or prop:FindFirstChild("SetCurrentSize")
                    if rem and rem:IsA("RemoteFunction") then
                        local newScale = math.clamp(st.scale * (want.Magnitude / cur.Magnitude), 0.05, SCALE_MAX)
                        if math.abs(newScale - st.scale) < 0.002 then
                            st.tries = SIZE_MAX_TRIES
                            if not st.warned then
                                st.warned = true
                                warn("[Megalodon] slot " .. slot .. " mentok batas scale " .. SCALE_MAX)
                            end
                        else
                            st.scale = newScale
                            st.at = now
                            st.tries += 1
                            budget -= 1
                            task.spawn(function() pcall(rem.InvokeServer, rem, newScale) end)
                        end
                    elseif not st.warned then
                        st.warned = true
                        warn("[Megalodon] remote SetCurrentScale/SetCurrentSize ga ketemu di slot " .. slot)
                    end
                end
            end
        end
    end
end

-- ============================================================
-- WARNA
-- ============================================================
local lastColorTick = 0
local function processColors(now)
    if now - lastColorTick < 0.1 then return end
    lastColorTick = now
    local budget = COLOR_BUDGET
    for slot = 1, TOTAL do
        if budget <= 0 then break end
        local prop = PROP_CACHE[slot]
        if prop and prop.Parent then
            local want = WANT_COLOR[slot] or propdata[slot].c
            local sent = COLOR_SENT[slot]
            if (not sent or colorDiff(sent, want) > COLOR_TOLERANCE) and not COLOR_BUSY[slot] then
                local rem = prop:FindFirstChild("ChangePropColor")
                if rem and rem:IsA("RemoteFunction") then
                    COLOR_BUSY[slot] = true
                    budget -= 1
                    task.spawn(function()
                        local ok = pcall(rem.InvokeServer, rem, want)
                        COLOR_BUSY[slot] = nil
                        if ok then COLOR_SENT[slot] = want end
                    end)
                end
            end
        end
    end
end

-- ganti warna patah-patah: tiap COLOR_STEP_TIME cuma 1 prop yang ganti, propnya acak, warnanya acak
local CYCLE_LIST = {}
local nextColorAt = 0
local function updateCycleColors(t)
    if not ColorAuto then return end
    if #CYCLE_LIST == 0 then
        for slot in pairs(CYCLE_SLOT) do CYCLE_LIST[#CYCLE_LIST + 1] = slot end
        table.sort(CYCLE_LIST)
    end
    local n = #CYCLE_COLORS
    if #CYCLE_LIST == 0 or n < 2 then return end
    if lastColorStep == -1 then            -- pertama kali: kasih warna acak ke semua dulu
        lastColorStep = 0
        for _, slot in ipairs(CYCLE_LIST) do
            WANT_COLOR[slot] = CYCLE_COLORS[math.random(n)]
        end
        nextColorAt = t + COLOR_STEP_TIME
        return
    end
    if t < nextColorAt then return end
    nextColorAt = t + COLOR_STEP_TIME
    local slot = CYCLE_LIST[math.random(#CYCLE_LIST)]
    local cur = WANT_COLOR[slot]
    local new = CYCLE_COLORS[math.random(n)]
    for _ = 1, 4 do
        if new ~= cur then break end       -- usahain warnanya beda dari yang sekarang
        new = CYCLE_COLORS[math.random(n)]
    end
    WANT_COLOR[slot] = new
end

local function resetBaseColors()
    for slot in pairs(CYCLE_SLOT) do
        WANT_COLOR[slot] = propdata[slot].c
    end
    lastColorStep = -1
end

-- ============================================================
-- TEXTURE (ApplyTexture) - cuma prop putih, kecuali TEXTURE_ON_COLORED
-- ============================================================
local lastTexTick = 0
local function processTextures(now)
    if not TEXTURE_NAME then return end
    if now - lastTexTick < 0.25 then return end
    lastTexTick = now
    local budget = TEXTURE_BUDGET
    for slot = 1, TOTAL do
        if budget <= 0 then break end
        local prop = PROP_CACHE[slot]
        if prop and prop.Parent and (TEXTURE_ON_COLORED or not CYCLE_SLOT[slot])
            and TEX_SENT[slot] ~= TEXTURE_NAME and not TEX_BUSY[slot] then
            local rem = prop:FindFirstChild("ApplyTexture")
            if rem and rem:IsA("RemoteFunction") then
                TEX_BUSY[slot] = true
                budget -= 1
                task.spawn(function()
                    local ok = pcall(rem.InvokeServer, rem, TEXTURE_NAME)
                    TEX_BUSY[slot] = nil
                    if ok then TEX_SENT[slot] = TEXTURE_NAME end
                end)
            end
        end
    end
end

