-- LOOP UTAMA
-- ============================================================
local lastScan, summonAt, lastLabel = 0, 0, 0

track(RS.Heartbeat:Connect(function(dt)
    if not running then return end
    dt = math.min(dt, 0.1)
    local t = os.clock()

    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")

    if IsInvisible then
        for part, _ in pairs(VisibleParts) do
            if part and part.Parent and part.Transparency ~= 1 then
                pcall(function() part.Transparency = 1 end)
            end
        end
    end

    -- ---------- FLY (J) ----------
    local moveMag, yawRate = 0, 0
    local newPos = nil
    flyVert = 0
    if FlyActive and root and root.Parent then
        if not flyPos or (root.Position - flyPos).Magnitude > FLY_RESYNC then
            flyPos = root.Position      -- ketarik / teleport dari luar: ikut posisi baru
        end
        local md = hum and hum.MoveDirection or Vector3.zero
        md = Vector3.new(md.X, 0, md.Z)
        moveMag = math.min(md.Magnitude, 1)
        do
            -- badan muter ngadep arah kamera
            local cam = workspace.CurrentCamera
            local cl = cam and cam.CFrame.LookVector
            if cl and cl.X * cl.X + cl.Z * cl.Z > 1e-4 then
                local targetYaw = math.atan2(-cl.X, -cl.Z)
                local dYaw = (targetYaw - flyYaw + math.pi) % (2 * math.pi) - math.pi
                local k = 1 - math.exp(-TURN_SMOOTH * dt)
                flyYaw += dYaw * k
                yawRate = dYaw * k / math.max(dt, 1e-3)
            end
        end
        flyVert = readVertical()
        local v = md * flySpeed + Vector3.new(0, flyVert * flySpeed * VERTICAL_RATIO, 0)
        flyPos = flyPos + v * dt        -- pakai flyPos, bukan root.Position: gravitasi ga nambah turun pas diem
        newPos = flyPos
    end

    -- ---------- SOUL / ถอดจิต (K): จิตบินตาม input, ร่างค้างไว้กับที่ ----------
    soulVel = Vector3.zero
    if SoulActive and soulCore and soulCore.Parent then
        local moveVec = Vector3.zero
        pcall(function()
            moveVec = require(LP.PlayerScripts.PlayerModule):GetControls():GetMoveVector()
        end)
        local cam = workspace.CurrentCamera
        local camCF = cam and cam.CFrame or CFrame.new()
        -- เดินหน้าตามกล้องแบบ "แนวราบ" เท่านั้น (ตัดแกน Y) เหมือน Fly (J) ปกติ
        -- มองขึ้น/ลงแล้วกด W จะไม่ทำให้จิตพุ่งขึ้นหรือดิ่งลง ขึ้นลงต้องกด Space/E หรือ Ctrl/Q เท่านั้น
        local look3d = camCF.LookVector
        local flatLook = Vector3.new(look3d.X, 0, look3d.Z)
        if flatLook.Magnitude > 1e-4 then flatLook = flatLook.Unit end
        local dir = (camCF.RightVector * moveVec.X) + (flatLook * -moveVec.Z)
        local sv = readVertical()
        if sv ~= 0 then dir = dir + Vector3.new(0, sv * 0.9, 0) end
        if dir.Magnitude > 0.01 then
            dir = dir.Unit
            soulVel = dir * flySpeed
        end
        soulPos = soulPos + soulVel * dt
        soulCore.CFrame = CFrame.new(soulPos, soulPos + ((flatLook.Magnitude > 1e-4 and flatLook) or camCF.LookVector))
    end

    -- ---------- LEAN (pitch 0 = ga condong depan) ----------
    do
        local tp, tr = 0, 0
        if FlyActive then
            local sf = math.clamp(flySpeed / 60, 0.5, 1.0)
            tp = -moveMag * LEAN_PITCH * sf
            tr = math.clamp(yawRate * (LEAN_ROLL / 3), -LEAN_ROLL, LEAN_ROLL) * sf
        end
        local k = 1 - math.exp(-LEAN_SMOOTH * dt)
        leanPitch += (tp - leanPitch) * k
        leanRoll  += (tr - leanRoll) * k
    end

    if newPos and root then
        if hum and not hum.PlatformStand then hum.PlatformStand = true end
        root.CFrame = CFrame.new(newPos) * CFrame.Angles(0, flyYaw, 0) * CFrame.Angles(leanPitch, 0, leanRoll)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    -- ---------- PROPS ----------
    if petMode and ((root and root.Parent) or (SoulActive and soulCore and soulCore.Parent)) then
        if t - lastScan > 0.8 then
            lastScan = t
            UpdateProps()
            if not warnedNoProp and t - summonAt > 3 then
                local filled = 0
                for slot = 1, TOTAL do if PROP_CACHE[slot] then filled += 1 end end
                if filled == 0 then
                    warnedNoProp = true
                    warn("[Megalodon] ga ada prop milik " .. OwnerName .. " yang ke-match. Spawn dulu " .. TOTAL .. " prop-nya.")
                end
            end
        end

        local rootCF, rootPos, vel
        if SoulActive and soulCore and soulCore.Parent then
            rootCF  = soulCore.CFrame
            rootPos = soulPos
            vel     = soulVel
        else
            rootCF  = root.CFrame
            rootPos = rootCF.Position
            local delta = rootPos - lastPosition
            vel = delta / math.max(dt, 0.001)
            if delta.Magnitude > TELEPORT_SNAP then vel = Vector3.zero end
        end
        lastPosition = rootPos

        if estimatedPing > 0.15 then
            NETWORK_TICK_RATE = math.clamp(estimatedPing * 0.5, BASE_TICK_RATE, 0.08)
        else
            NETWORK_TICK_RATE = BASE_TICK_RATE
        end

        -- gerak? (buat animasi jalan)
        local horiz = Vector3.new(vel.X, 0, vel.Z).Magnitude
        local mdMag = hum and hum.MoveDirection.Magnitude or 0
        local speedNow = FlyActive and vel.Magnitude or horiz
        if speedNow > 1 or mdMag > 0.1 or flyVert ~= 0 or soulVel.Magnitude > 1 then lastMoveT = t end
        local moving = (t - lastMoveT) < STOP_DEBOUNCE

        -- nutup lag smoothDamp (steady-state lag = kecepatan * FOLLOW_TIME), biar ga ketinggalan pas gerak
        velSm = velSm:Lerp(vel, 1 - math.exp(-8 * dt))
        local lead = velSm * FOLLOW_TIME
        if lead.Magnitude > MAX_LEAD then lead = lead.Unit * MAX_LEAD end
        local targetPos = rootPos + lead

        local lk = rootCF.LookVector
        local tYaw = anchorYaw
        if lk.X * lk.X + lk.Z * lk.Z > 1e-4 then
            tYaw = math.atan2(-lk.X, -lk.Z)
        end

        local snapProps = snapNextFrame
        if snapNextFrame or not anchorPos or (targetPos - anchorPos).Magnitude > 120 then
            anchorPos, anchorVel = targetPos, Vector3.zero
            anchorYaw, anchorYawVel = tYaw, 0
            snapProps = true
        else
            anchorPos, anchorVel = smoothDamp(anchorPos, targetPos, anchorVel, FOLLOW_TIME, dt)
            local dYaw = (tYaw - anchorYaw + math.pi) % (2 * math.pi) - math.pi
            anchorYaw, anchorYawVel = smoothDamp(anchorYaw, anchorYaw + dYaw, anchorYawVel, ROTATE_TIME, dt)
        end

        -- animasi jalan: ayun walk 1 <-> walk 2 (sinus, ga ada berhenti-patah), makin cepat gerak makin cepet ayunnya
        if moving then
            walkBlend = math.min(1, walkBlend + dt / BLEND_IN_TIME)
            walkPhase = (walkPhase + dt * WALK_CYCLES_PER_SEC) % 1   -- tetap, ga ikut kecepatan player
        else
            walkBlend = math.max(0, walkBlend - dt / BLEND_OUT_TIME)
            if walkBlend <= 0 then walkPhase = 0 end
        end
        local wb = smootherstep(walkBlend)
        local walking = wb > 0.0005
        local sw = 0.5 - 0.5 * math.cos(2 * math.pi * walkPhase)

        -- semua prop ikut 1 base yang sama, jadi badan ga ada yang ketinggalan
        local base = CFrame.new(anchorPos + Vector3.new(0, GLOBAL_RAISE, 0)) * CFrame.Angles(0, anchorYaw + BODY_YAW_OFFSET, 0)
            * CFrame.Angles(leanPitch, 0, leanRoll)

        local alpha = math.clamp(1 - math.exp(-LERP_SPEED * dt), 0, 1)

        updateCycleColors(t)

        for slot = 1, TOTAL do
            local prop = PROP_CACHE[slot]
            if prop and prop.Parent then
                local pose = propdata[slot].cf
                if walking then
                    local w1, w2 = Walk1Data[slot], Walk2Data[slot]
                    if w1 and w2 then
                        pose = pose:Lerp(w1.cf:Lerp(w2.cf, sw), wb)
                    end
                end
                local targetCF = base * pose
                local cur = CURRENT_CFRAMES[slot]
                if snapProps or not cur then
                    CURRENT_CFRAMES[slot] = targetCF
                else
                    CURRENT_CFRAMES[slot] = cur:Lerp(targetCF, alpha)
                end
            end
        end
        snapNextFrame = false

        processSizes(t)
        processColors(t)
        processTextures(t)
        flushSends(t)
    end

    if t - lastLabel > 0.25 then
        lastLabel = t
        ModeLabel.Text = "MODE: " .. (SoulActive and "SOUL ถอดจิต (K)" or (FlyActive and "FLY (J)" or (petMode and "FOLLOW" or "OFF")))
    end
end))

