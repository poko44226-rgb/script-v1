-- ============================================================
local VisibleParts, noclipParts = {}, {}
local lastNoclipRefresh = 0

local function SetupCharacter()
    local char = LP.Character
    if not char then return end
    table.clear(VisibleParts)
    for _, d in ipairs(char:GetDescendants()) do
        if (d:IsA("BasePart") or d:IsA("Decal")) and d.Name ~= "HumanoidRootPart" then
            VisibleParts[d] = d.Transparency
        end
    end
    lastNoclipRefresh = 0
end

local function SetInvisible(on)
    if on == IsInvisible then return end
    IsInvisible = on
    setState(InvisibleBtn, "Invisible", on)
    if on then SetupCharacter() end
    for part, orig in pairs(VisibleParts) do
        if part and part.Parent then
            pcall(function() part.Transparency = on and 1 or orig end)
        end
    end
end

local function restoreNaturalCollision(char)
    if not char then return end
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("BasePart") then
            local n = v.Name:lower()
            local solid = (n:find("torso") or n:find("root") or n:find("leg") or n:find("head")) ~= nil
            v.CanCollide = solid and not noclip
        end
    end
end

local function SetNoclip(on)
    noclip = on
    setState(NoclipBtn, "Noclip", on)
    restoreNaturalCollision(LP.Character)
    lastNoclipRefresh = 0
end

local function setSpeed(n)
    n = tonumber(n) or flySpeed
    flySpeed = math.clamp(math.floor(n + 0.5), FLY_MIN, FLY_MAX)
    SpeedBox.Text = tostring(flySpeed)
end

local function SetColorAuto(on)
    ColorAuto = on
    setState(ColorBtn, "Warna Auto", on)
    if not on then resetBaseColors() end
end

local function SetFly(on)
    if on == FlyActive then return end
    FlyActive = on
    setState(FlyBtn, "Fly", on)
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local animate = char and char:FindFirstChild("Animate")
    if on then
        if hum then
            hum.PlatformStand = true
            local animator = hum:FindFirstChildOfClass("Animator")
            if animator then
                for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do pcall(function() tr:Stop(0.1) end) end
            end
        end
        if animate then animate.Disabled = true end
        if root then
            flyPos = root.Position
            local lk = root.CFrame.LookVector
            if lk.X * lk.X + lk.Z * lk.Z > 1e-4 then
                flyYaw = math.atan2(-lk.X, -lk.Z)
            end
        end
    else
        upHeld, downHeld, flyVert = false, false, 0
        flyPos = nil
        if animate then animate.Disabled = false end
        if root then
            root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, flyYaw, 0)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
        if hum then
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end
end

local function SetSummon(on)
    petMode = on
    SummonBtn.Text = on and "MUTANT MEGALODON: ON" or "SUMMON MUTANT MEGALODON"
    SummonBtn.BackgroundColor3 = on and BTN_ON or BTN_BG
    if on then
        SetupCharacter()
        snapNextFrame = true
        anchorPos = nil
        warnedNoProp = false
        lastColorStep = -1
        SetNoclip(true)
        UpdateProps()
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then lastPosition = root.Position end
    else
        SetInvisible(false)
        SetFly(false)
        SetNoclip(false)
        table.clear(CURRENT_CFRAMES)
        table.clear(LAST_SEND_TIME)
        table.clear(LAST_SENT_CF)
        table.clear(INFLIGHT)
    end
end

-- ============================================================
-- SOUL / ถอดจิต (K)  -- จิตหลุดจากร่าง, กล้องตามจิต, เมกาโลดอนว่ายตามจิต
-- WASD = เดินตามกล้อง | Space/E = ขึ้น | Ctrl/Q = ลง | ความเร็วใช้ FLY SPEED
-- ============================================================
local function SetSoul(on)
    if on == SoulActive then return end
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if on and not (root and root.Parent) then return end
    SoulActive = on
    setState(SoulBtn, "ถอดจิต (K)", on)
    if on then
        if not petMode then SetSummon(true) end
        if FlyActive then SetFly(false) end
        SetInvisible(true)
        soulPos = root.Position + Vector3.new(0, 10, 0)
        soulCore = Instance.new("Part")
        soulCore.Name = "MegalodonSoul"
        soulCore.Size = Vector3.new(1.2, 1.2, 1.2)
        soulCore.Transparency = 1
        soulCore.CanCollide = false
        soulCore.CanQuery = false
        soulCore.Anchored = true
        soulCore.CFrame = CFrame.new(soulPos)
        soulCore.Parent = workspace

        -- ใช้ Custom + CameraSubject เพื่อให้ปัดหมุนกล้องบนมือถือได้ตามปกติ
        workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
        workspace.CurrentCamera.CameraSubject = soulCore
        -- ปิดการเด้งชนกำแพงของกล้อง (เปลี่ยนสิ่งกีดขวางให้โปร่งใสแทนการดันกล้อง)
        pcall(function()
            LP.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
        end)

        if hum then
            hum.WalkSpeed = 0
            hum.JumpPower = 0
            hum.PlatformStand = true
        end
        if root and root.Parent then
            root.Anchored = true
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
        soulVel = Vector3.zero
        anchorPos = nil
        snapNextFrame = true
    else
        if soulCore then soulCore:Destroy() soulCore = nil end
        SetInvisible(false)

        -- คืนค่าการชนของกล้องกลับเป็นปกติ
        pcall(function()
            LP.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Zoom
        end)

        if root and root.Parent then
            root.Anchored = false
        end
        if hum and hum.Parent then
            hum.WalkSpeed = 16
            hum.JumpPower = 50
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
            workspace.CurrentCamera.CameraSubject = hum
        end
        soulVel = Vector3.zero
        anchorPos = nil
        snapNextFrame = true
    end
end

