local function readVertical()
    local up = 0
    if upHeld then up += 1 end
    if downHeld then up -= 1 end
    if not UIS:GetFocusedTextBox() then
        if UIS:IsKeyDown(Enum.KeyCode.Space) or UIS:IsKeyDown(Enum.KeyCode.E) then up += 1 end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) then up -= 1 end
    end
    return math.clamp(up, -1, 1)
end

-- ============================================================
-- KIRIM POSISI
-- ============================================================
local function pushProp(slot, prop, cf, sendCF, t)
    local rem = REMOTE_CACHE[slot]
    if not rem or not rem.Parent then
        rem = prop:FindFirstChild("SetCurrentCFrame")
        REMOTE_CACHE[slot] = rem
    end
    if not rem or not rem:IsA("RemoteFunction") then return false end

    LAST_SEND_TIME[slot] = t
    LAST_SENT_CF[slot]   = cf          -- yang dibandingin = posisi asli, bukan yang diprediksi

    INFLIGHT[slot] = (INFLIGHT[slot] or 0) + 1
    task.spawn(function()
        local ok = pcall(rem.InvokeServer, rem, sendCF)
        INFLIGHT[slot] = math.max(0, (INFLIGHT[slot] or 1) - 1)
        if ok then
            estimatedPing = estimatedPing * 0.98 + (os.clock() - t) * 0.02
        end
    end)
    return true
end

local sendCursor = 1
local function flushSends(t)
    local budget = MAX_SENDS_PER_FRAME
    -- prediksi: geser posisi kirim sedikit ke depan sesuai kecepatan, buat nutup delay jaringan
    local extrap = math.clamp(NETWORK_TICK_RATE * 0.5 + estimatedPing * 0.5, 0, 0.12)
    local push = anchorVel * extrap
    for _ = 1, TOTAL do
        if budget <= 0 then break end
        local slot = sendCursor
        sendCursor = slot % TOTAL + 1
        local prop, cf = PROP_CACHE[slot], CURRENT_CFRAMES[slot]
        if prop and prop.Parent and cf then
            local lastT = LAST_SEND_TIME[slot] or 0
            local inflight = INFLIGHT[slot] or 0
            if inflight >= MAX_INFLIGHT and t - lastT > MAX_CHOKE_TIMEOUT then
                INFLIGHT[slot], inflight = 0, 0   -- balasan nyangkut, lepas gate
            end
            if t - lastT >= NETWORK_TICK_RATE and inflight < MAX_INFLIGHT then
                local last = LAST_SENT_CF[slot]
                local changed = not last
                    or (cf.Position - last.Position).Magnitude > POS_EPS
                    or cf.LookVector:Dot(last.LookVector) < ROT_EPS
                    or cf.UpVector:Dot(last.UpVector) < ROT_EPS
                if changed or (t - lastT) > REFRESH_TIME then
                    if pushProp(slot, prop, cf, cf + push, t) then budget -= 1 end
                end
            end
        end
    end
end

