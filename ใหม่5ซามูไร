-- ============================================================
-- KIRIM POSISI (round-robin, dibatasi per frame)
-- ============================================================
local function pushProp(slot, prop, cf, t)
    local rem = REMOTE_CACHE[slot]
    if not rem or not rem.Parent then
        rem = prop:FindFirstChild("SetCurrentCFrame")
        REMOTE_CACHE[slot] = rem
    end
    if not rem then return false end
    LAST_SEND_TIME[slot] = t
    LAST_SENT_CF[slot]   = cf

    if rem:IsA("RemoteEvent") then
        pcall(rem.FireServer, rem, cf)
        return true
    end
    if not rem:IsA("RemoteFunction") then return false end

    local id = (TOKEN[slot] or 0) + 1
    TOKEN[slot] = id
    BUSY_UNTIL[slot] = t + MAX_CHOKE_TIMEOUT
    task.spawn(function()
        local ok = pcall(rem.InvokeServer, rem, cf)
        if TOKEN[slot] == id then BUSY_UNTIL[slot] = 0 end
        if ok then
            estimatedPing = estimatedPing * 0.98 + (os.clock() - t) * 0.02
        end
    end)
    return true
end

local sendCursor = 1
local function flushSends(t)
    local budget = MAX_SENDS_PER_FRAME
    for _ = 1, TOTAL do
        if budget <= 0 then break end
        local slot = sendCursor
        sendCursor = slot % TOTAL + 1
        local prop, cf = PROP_CACHE[slot], CURRENT_CFRAMES[slot]
        if prop and prop.Parent and cf then
            local lastT = LAST_SEND_TIME[slot] or 0
            if t - lastT >= NETWORK_TICK_RATE and t >= (BUSY_UNTIL[slot] or 0) then
                local last = LAST_SENT_CF[slot]
                local changed = not last
                    or (cf.Position - last.Position).Magnitude > POS_EPS
                    or cf.LookVector:Dot(last.LookVector) < ROT_EPS
                    or cf.UpVector:Dot(last.UpVector) < ROT_EPS
                if changed or (t - lastT) > REFRESH_TIME then
                    if pushProp(slot, prop, cf, t) then budget -= 1 end
                end
            end
        end
    end
end

-- ============================================================
-- LOOP UTAMA
-- ============================================================
local lastScan, lastMoveT = 0, 0
local wasMoving = false
local walkBlend, walkPhase = 0, 0

track(RS.Heartbeat:Connect(function(dt)
    if not running then return end
    dt = math.min(dt, 0.1)

    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildOfClass("Humanoid")

    if IsInvisible then
        for part, _ in pairs(VisibleParts) do
            if part and part.Parent and part.Transparency ~= 1 then
                pcall(function() part.Transparency = 1 end)
            end
        end
    end

    if petMode and root and root.Parent then
        local t = os.clock()
        if t - lastScan > 0.5 then
            lastScan = t
            UpdateProps()
        end

        local rootCF  = root.CFrame
        local rootPos = rootCF.Position
        local delta   = rootPos - lastPosition
        lastPosition  = rootPos

        local vel = delta / math.max(dt, 0.001)
        if delta.Magnitude > TELEPORT_SNAP then vel = Vector3.zero end
        local horiz = Vector3.new(vel.X, 0, vel.Z).Magnitude
        local rawMoving = horiz > 1 or (hum ~= nil and hum.MoveDirection.Magnitude > 0.1)
        if rawMoving then lastMoveT = t end
        local moving = (t - lastMoveT) < STOP_DEBOUNCE

        if estimatedPing > 0.15 then
            NETWORK_TICK_RATE = math.clamp(estimatedPing * 0.5, BASE_TICK_RATE, 0.08)
        else
            NETWORK_TICK_RATE = BASE_TICK_RATE
        end

        local targetY = rootPos.Y
        velSm = velSm:Lerp(Vector3.new(vel.X, 0, vel.Z), 1 - math.exp(-12 * dt))
        local lead = velSm * (LEAD_EXTRA + math.clamp(estimatedPing, 0.02, 0.2))
        if lead.Magnitude > MAX_LEAD then lead = lead.Unit * MAX_LEAD end
        local targetPos = Vector3.new(rootPos.X, targetY, rootPos.Z) + lead

        local lk = rootCF.LookVector
        local tYaw = anchorYaw
        if lk.X * lk.X + lk.Z * lk.Z > 1e-4 then
            tYaw = math.atan2(-lk.X, -lk.Z)
        end

        local snapProps = snapNextFrame
        if snapNextFrame or not anchorPos or (targetPos - anchorPos).Magnitude > 120 then
            anchorPos, anchorVel = targetPos, Vector3.zero
            anchorYaw, anchorYawVel = tYaw, 0
            snapProps = true
        else
            anchorPos, anchorVel = smoothDamp(anchorPos, targetPos, anchorVel, FOLLOW_TIME, dt)
            local dYaw = (tYaw - anchorYaw + math.pi) % (2 * math.pi) - math.pi
            anchorYaw, anchorYawVel = smoothDamp(anchorYaw, anchorYaw + dYaw, anchorYawVel, ROTATE_TIME, dt)
        end
        local anchorCF = CFrame.new(anchorPos) * CFrame.Angles(0, anchorYaw, 0)

        if moving then
            if not wasMoving and walkBlend < 0.02 then walkPhase = 0 end
            walkBlend = math.min(1, walkBlend + dt / BLEND_IN_TIME)
            walkPhase = (walkPhase + dt * WALK_CYCLES_PER_SEC) % 1
        else
            walkBlend = math.max(0, walkBlend - dt / BLEND_OUT_TIME)
        end
        wasMoving = moving

        local wb = smootherstep(walkBlend)
        local nWalk = #WalkPoses
        local wu = walkPhase * nWalk
        local wi = math.floor(wu)
        local wE = 0.5 * (1 - math.cos(math.pi * (wu - wi)))   -- ease halus antar pose
        local wA = WalkPoses[wi % nWalk + 1]
        local wB = WalkPoses[(wi + 1) % nWalk + 1]
        local walking = wb > 0.0005

        -- SKILL: siap siap nombak (toggle) + nombak (sekali tusuk)
        local striking   = t < strikeUntil
        local skillWant  = (skillReady or striking) and 1 or 0
        local strikeWant = striking and 1 or 0
        local skillStep  = dt / ((skillWant > skillBlend) and SKILL_IN_TIME or SKILL_OUT_TIME)
        skillBlend  = skillBlend + math.clamp(skillWant - skillBlend, -skillStep, skillStep)
        local strikeStep = dt / ((strikeWant > strikeBlend) and STRIKE_IN_TIME or STRIKE_OUT_TIME)
        strikeBlend = strikeBlend + math.clamp(strikeWant - strikeBlend, -strikeStep, strikeStep)
        local sk  = smootherstep(skillBlend)
        local stk = smootherstep(strikeBlend)
        local skilling = sk > 0.0005

        local offset   = Config.Idle.Offset:Lerp(Config.Walk.Offset, wb)
        local rotation = Config.Idle.Rotation:Lerp(Config.Walk.Rotation, wb)
        local lerpSpeed = IDLE_LERP_SPEED + (WALK_LERP_SPEED - IDLE_LERP_SPEED) * wb
        lerpSpeed = lerpSpeed + (STRIKE_LERP_SPEED - lerpSpeed) * stk
        local alpha = math.clamp(1 - math.exp(-lerpSpeed * dt), 0, 1)

        local base = anchorCF * CFrame.new(offset)
            * CFrame.Angles(math.rad(rotation.X), math.rad(rotation.Y), math.rad(rotation.Z))

        for slot = 1, TOTAL do
            local prop = PROP_CACHE[slot]
            if prop and prop.Parent then
                local idle = IdleData[slot]
                local pose = idle.cf
                local sz   = idle.size
                local col  = idle.c
                if walking then
                    local w1, w2 = wA[slot], wB[slot]
                    pose = pose:Lerp(w1.cf:Lerp(w2.cf, wE), wb)
                    sz   = sz:Lerp(w1.size:Lerp(w2.size, wE), wb)
                    col  = col:Lerp(w1.c:Lerp(w2.c, wE), wb)
                end
                if skilling then
                    local s1, s2 = Skill1Data[slot], Skill2Data[slot]
                    pose = pose:Lerp(s1.cf:Lerp(s2.cf, stk), sk)
                    sz   = sz:Lerp(s1.size, sk)
                    if sk > 0.5 then col = s1.c end   -- warna skill langsung ganti (hemat request)
                end
                WANT_SIZE[slot]  = sz
                WANT_COLOR[slot] = col
                local targetCF = base * pose
                local cur = CURRENT_CFRAMES[slot]
                if snapProps or not cur then
                    CURRENT_CFRAMES[slot] = targetCF
                else
                    CURRENT_CFRAMES[slot] = cur:Lerp(targetCF, alpha)
                end
            end
        end
        snapNextFrame = false

        processSizes(t)
        processColors(t)
        flushSends(t)
    end

    -- AIR WALK
    if AirWalkActive and root and root.Parent then
        local now = os.clock()
        if now - lastGroundScan > 0.1 then
            lastGroundScan = now
            UpdateGroundY()
        end
        SmoothHeight = SmoothHeight + (CurrentGroundY + TargetHeight - SmoothHeight) * 0.15
        Platform.Position = Vector3.new(root.Position.X, SmoothHeight - 3.5, root.Position.Z)
        if math.abs(root.Position.Y - SmoothHeight) > 1 then
            root.CFrame = CFrame.new(root.Position.X, SmoothHeight, root.Position.Z) * root.CFrame.Rotation
        end
    end
end))

-- NOCLIP
track(RS.RenderStepped:Connect(function()
    if not running or not noclip then return end
    local char = LP.Character
    if not char then return end
    local now = os.clock()
    if now - lastNoclipRefresh > 1 then
        lastNoclipRefresh = now
        table.clear(noclipParts)
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then noclipParts[#noclipParts + 1] = v end
        end
    end
    for i = 1, #noclipParts do
        local v = noclipParts[i]
        if v.Parent and v.CanCollide then v.CanCollide = false end
    end
end))

track(LP.CharacterAdded:Connect(function()
    task.wait(1)
    if not running then return end
    IsInvisible, AirWalkActive = false, false
    Platform.CanCollide = false
    Platform.Position = Vector3.new(0, -999, 0)
    setState(InvisibleBtn, "INVISIBLE", false)
    setState(AirWalkBtn, "Air Walk", false)
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then lastPosition = root.Position end
    snapNextFrame = true
    SetupCharacter()
end))

_G.__MushashiStop = function()
    running = false
    pcall(function()
        for part, orig in pairs(VisibleParts) do
            if part and part.Parent then part.Transparency = orig end
        end
    end)
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    pcall(function() ScreenGui:Destroy() end)
    pcall(function() Platform:Destroy() end)
end

