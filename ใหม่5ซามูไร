local function smoothDamp(current, target, vel, smoothTime, dt)
    smoothTime = math.max(0.0001, smoothTime)
    local omega = 2 / smoothTime
    local x = omega * dt
    local e = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x)
    local change = current - target
    local temp = (vel + change * omega) * dt
    local newVel = (vel - temp * omega) * e
    return target + (change + temp) * e, newVel
end

local function smootherstep(x)
    x = math.clamp(x, 0, 1)
    return x * x * x * (x * (x * 6 - 15) + 10)
end

local function colorDiff(a, b)
    return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B)
end

