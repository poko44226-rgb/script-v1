local petMode = false
local rampageMode = false
local TargetPlayer = nil
local hasFetchedBall = false

local SWITCH_INTERVAL = 1.2
local lastSwitch = 0

local cachedBall = nil
local lastBallCheck = 0

local function GetBallSilent()
    local t = tick()
    if cachedBall and not cachedBall.Parent then cachedBall = nil end
    if t - lastBallCheck < 0.5 then return cachedBall end
    lastBallCheck = t

    local b = player.Backpack:FindFirstChild("SoccerBall") or (player.Character and player.Character:FindFirstChild("SoccerBall"))
    if not b and not hasFetchedBall then
        hasFetchedBall = true
        pcall(function()
            game:GetService("ReplicatedStorage").RE:FindFirstChild("1Too1l"):InvokeServer("PickingTools", "SoccerBall")
        end)
    end

    local ballsFolder = Workspace:FindFirstChild("WorkspaceCom") and Workspace.WorkspaceCom:FindFirstChild("001_SoccerBalls")
    if ballsFolder then
        local ball = ballsFolder:FindFirstChild("Soccer" .. player.Name)
        if ball then
            ball.CanCollide = false
            cachedBall = ball
            return ball
        end
    end
    cachedBall = nil
    return nil
end

local function getTargetTorso(plr)
    if not plr or not plr.Parent or not plr.Character then return nil end
    local char = plr.Character
    return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
end

local function FindNearestPrey()
    local nearestPlayer = nil
    local shortestDistance = 400
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and not hum.Sit then
                local torso = getTargetTorso(p)
                if torso then
                    local dist = (myPos - torso.Position).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        nearestPlayer = p
                    end
                end
            end
        end
    end
    return nearestPlayer
end

local function getAttackablePlayers()
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 and not hum.Sit and getTargetTorso(p) then
				table.insert(list, p)
			end
		end
	end
	return list
end

RunService.Heartbeat:Connect(function(dt)
    if not petMode then return end
    local activeBall = GetBallSilent()

    local enemyTorso = TargetPlayer and getTargetTorso(TargetPlayer) or nil

    if rampageMode and (not TargetPlayer or not enemyTorso or tick() - lastSwitch >= SWITCH_INTERVAL) then
        lastSwitch = tick()
        local list = getAttackablePlayers()
        if #list > 0 then
            local idx = 0
            for i, p in ipairs(list) do
                if p == TargetPlayer then idx = i break end
            end
            TargetPlayer = list[(idx % #list) + 1]
            enemyTorso = getTargetTorso(TargetPlayer)
            Box.Text = "กำลังโจมตี: " .. TargetPlayer.DisplayName
        else
            TargetPlayer = nil
            enemyTorso = nil
            Box.Text = "[กำลังโจมตี: ไม่มีเป้า]"
        end
    end

    if enemyTorso then
        StatusLabel.Text = "กำลังโจมตี: " .. TargetPlayer.Name
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)

        local enemyVelocity = enemyTorso.AssemblyLinearVelocity
        local flatVel = Vector3.new(enemyVelocity.X, 0, enemyVelocity.Z)
        local speed = flatVel.Magnitude
        local leadDistance = speed > 15 and 14 or 4

        local interceptPos = enemyTorso.Position
        if speed > 0.1 then
            interceptPos = enemyTorso.Position + (flatVel.Unit * leadDistance)
        end

        if activeBall then
            activeBall.CFrame = CFrame.new(interceptPos)
            activeBall.Velocity = Vector3.new(0, 9e10, 0)
        end
    else

        if TargetPlayer then
            StatusLabel.Text = "ล็อกเป้าไว้: " .. TargetPlayer.Name .. " (รอตัวละครพร้อม...)"
        else
            StatusLabel.Text = "สถานะ: รอเลือกเป้าหมาย..."
        end
        StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 0)
    end
end)

