Box.FocusLost:Connect(function(enter)
    if enter then
        local searchKey = Box.Text:lower()
        if searchKey == "" then
            TargetPlayer = nil
            Box.Text = ""
            return
        end
        local found = false
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Name:lower():find(searchKey) or p.DisplayName:lower():find(searchKey) then
                TargetPlayer = p
                Box.Text = p.DisplayName
                found = true
                break
            end
        end
        if not found then

            if TargetPlayer then
                Box.Text = TargetPlayer.DisplayName
            else
                Box.Text = "[ไม่พบผู้เล่น]"
                task.wait(1)
                Box.Text = ""
            end
        end
    end
end)

