local function stepHead(dt, t, hum)
    local cp = VirtualRootCFrame.Position
    if t - lastGroundCalc > 0.05 then
        lastGroundCalc = t
        local g = findGroundY(HEAD.X, HEAD.Z, HEAD.Y, groundTarget)
        if g then groundTarget = g end
    end
    groundYSmooth = groundYSmooth + (groundTarget - groundYSmooth) * (1 - math.exp(-25 * dt))
    local floorY = groundYSmooth + HOVER
    local old = HEAD
    local newPos = HEAD

    if G.froz then
        G.fV, HEAD_SPEED = Vector3.zero, 0
    elseif G.act.name == "slash" or G.act.name == "div" then
        local function ss(x) x = math.clamp(x, 0, 1) return x * x * (3 - 2 * x) end
        local T = t - G.act.t0
        local R, V = 48, 100
        local sp, vy, spin, glide = 0, 0, 0, 0
        if G.act.name == "slash" then
            spin = ss(T / 0.9) * (1 - ss((T - 4.9) / 0.5))
            sp = V * spin
        else
            spin = ss(T / 0.7) * (1 - ss((T - 3.0) / 0.3))
            glide = ss((T - 2.9) / 0.3) * (1 - ss((T - 3.6) / 0.5))
            vy = 30 * ss((T - 0.2) / 1.0) * spin
            sp = V * spin + 75 * glide
        end
        local f = Vector3.new(HEAD_DIR.X, 0, HEAD_DIR.Z)
        if f.Magnitude < 0.05 then f = G.actFwd else f = f.Unit end
        if spin > 0.01 and glide < 0.5 then
            f = CFrame.fromAxisAngle(Vector3.yAxis, (V * spin / R) * dt):VectorToWorldSpace(f)
        elseif glide > 0.01 then
            local ang = math.acos(math.clamp(f:Dot(G.actFwd), -1, 1))
            if ang > 1e-3 then
                local sg = f:Cross(G.actFwd).Y >= 0 and 1 or -1
                f = CFrame.fromAxisAngle(Vector3.yAxis, sg * math.min(ang, 7 * dt)):VectorToWorldSpace(f)
            end
        end
        HEAD_DIR = f.Unit
        HEAD_SPEED = sp
        local ny
        if flyMode or G.act.name == "div" then ny = HEAD.Y else ny = HEAD.Y + (floorY - HEAD.Y) * (1 - math.exp(-6 * dt)) end
        newPos = Vector3.new(HEAD.X + HEAD_DIR.X * sp * dt, ny + vy * dt, HEAD.Z + HEAD_DIR.Z * sp * dt)
        G.fV = Vector3.zero
    elseif flyMode then
        local cam = workspace.CurrentCamera
        local md = hum and hum.MoveDirection or Vector3.zero
        local want
        if cam and md.Magnitude > 0.05 then
            local rel = cam.CFrame:VectorToObjectSpace(md)
            local raw = cam.CFrame.LookVector * -rel.Z + cam.CFrame.RightVector * rel.X
            if raw.Magnitude > 0.05 then want = raw.Unit end
        end
        local V = flySpeed * 30
        local ang = 0
        if want then
            ang = math.acos(math.clamp(HEAD_DIR:Dot(want), -1, 1))
            local turn = math.clamp(HEAD_SPEED / 110, 0.18, 1.4)
            local step = math.min(ang, turn * dt)
            if ang > 1e-3 then
                local axis = HEAD_DIR:Cross(want)
                if axis.Magnitude < 1e-4 then axis = Vector3.yAxis else axis = axis.Unit end
                HEAD_DIR = CFrame.fromAxisAngle(axis, step):VectorToWorldSpace(HEAD_DIR).Unit
            end
        end
        local spdT = 0
        if want then
            spdT = V
            if ang > 0.6 then spdT = math.max(V * 0.6, 14) end
        end
        HEAD_SPEED = HEAD_SPEED + (spdT - HEAD_SPEED) * math.min(dt * 3.2, 1)
        newPos = HEAD + HEAD_DIR * HEAD_SPEED * dt
        G.fV = HEAD_DIR * HEAD_SPEED
    else
        local pp = Vector3.new(cp.X, 0, cp.Z)
        local pv = (pp - G.lastP) / math.max(dt, 0.001)
        G.lastP = pp
        if pv.Magnitude > 300 then pv = Vector3.zero end
        G.pvS = G.pvS:Lerp(pv, 1 - math.exp(-8 * dt))
        local ps = G.pvS.Magnitude
        if not G.fTarget then G.fTarget = Vector3.new(HEAD.X, 0, HEAD.Z) end
        local want = Vector3.zero
        if G.guard then
            local me = Vector3.new(HEAD.X, 0, HEAD.Z)
            if not G.gOrigin then G.gOrigin = me G.gT = 0 end
            G.gT = G.gT + dt
            if not G.gTarget or (G.gTarget - me).Magnitude < 14 or G.gT > 16 then
                local ang, r = math.random() * math.pi * 2, 90 + math.random() * 420
                G.gTarget = G.gOrigin + Vector3.new(math.cos(ang) * r, 0, math.sin(ang) * r)
                G.gT = 0
            end
            local to = G.gTarget - me
            want = to.Unit * 34
        elseif followMode then
            if ps > 2 then G.fTarget = pp - G.pvS.Unit * FIG_DISTANCE end
            local me = Vector3.new(HEAD.X, 0, HEAD.Z)
            local to = G.fTarget - me
            local dist = to.Magnitude
            if dist > 400 then
                local f = Vector3.new(HEAD_DIR.X, 0, HEAD_DIR.Z)
                local gy = findGroundY(G.fTarget.X, G.fTarget.Z, cp.Y, nil) or groundTarget
                groundTarget, groundYSmooth = gy, gy
                initTrail(Vector3.new(G.fTarget.X, gy + HOVER, G.fTarget.Z), f)
                snapNextFrame = true
                return
            elseif dist > 1.5 then
                local cap = math.max(ps * 1.25 + 7, dist > 90 and 45 or 12)
                want = to.Unit * math.min(dist * 2.2, cap)
            end
        end
        local fm = G.fV.Magnitude
        if want.Magnitude > 0.5 and fm > 2 then
            local cu, wu = G.fV.Unit, want.Unit
            local ang = math.acos(math.clamp(cu:Dot(wu), -1, 1))
            local maxStep = math.clamp(fm / 110, 0.2, 1.6) * dt
            if ang > maxStep then
                local sg = cu:Cross(wu).Y >= 0 and 1 or -1
                local dir = CFrame.fromAxisAngle(Vector3.yAxis, sg * maxStep):VectorToWorldSpace(cu)
                want = dir * want.Magnitude
                G.fV = dir * fm
            end
        end
        G.fV = G.fV + (want - G.fV) * math.min(dt * 3.2, 1)
        local ny = HEAD.Y + (floorY - HEAD.Y) * (1 - math.exp(-6 * dt))
        newPos = Vector3.new(HEAD.X + G.fV.X * dt, ny, HEAD.Z + G.fV.Z * dt)
        HEAD_SPEED = G.fV.Magnitude
        HEAD_DIR = T0
    end

    pushHead(newPos)
    G.vel = G.fV

    if t < G.unwindUntil and not (G.act.name == "slash" or G.act.name == "div") then
        local f = Vector3.new(HEAD_DIR.X, 0, HEAD_DIR.Z)
        if f.Magnitude > 0.05 then
            f = f.Unit
            local k = 1 - math.exp(-4.5 * dt)
            for i = 1, #TRAIL do
                local tg = Vector3.new(HEAD.X - f.X * i * STEP, HEAD.Y, HEAD.Z - f.Z * i * STEP)
                TRAIL[i] = TRAIL[i]:Lerp(tg, k)
            end
        end
    end

    if G.camo then
        G.colAcc = G.colAcc + (newPos - old).Magnitude
        if G.colAcc >= CSTEP then
            G.colAcc = 0
            G.lastSample = t
            sampleCamo(true)
        elseif t - G.lastSample > 0.1 then
            G.lastSample = t
            sampleCamo(false)
        end
    end
end

local function sstep(x) x = math.clamp(x, 0, 1) return x * x * (3 - 2 * x) end
local ACT_DUR = { slash = 5.6, div = 7.4, roar = 4.2 }
local function stepAct2(dt, t)
    local a = G.act
    if not a.name then return end
    local T = t - a.t0
    if T >= (ACT_DUR[a.name] or 4) then
        if a.name == "slash" or a.name == "div" then G.unwindUntil = t + 1.8 end
        resetA()
        return
    end
    local nm = a.name
    if nm == "slash" then
        local e = sstep(T / 0.8) * (1 - sstep((T - 4.9) / 0.5))
        local gate = sstep((T - 1.2) / 0.4) * (1 - sstep((T - 4.7) / 0.4))
        A.tailPh = A.tailPh + dt * 8.5 * gate
        local sw = math.max(0, math.sin(A.tailPh))
        A.tail = sw * sw * gate
        A.jaw = e * (0.8 + 0.2 * math.sin(t * 30))
        A.shiver = 0.4 * e + 0.8 * A.tail
    elseif nm == "div" then
        if T >= 3.7 and not a.snd then a.snd = true if G.roar then G.roar() end end
        local roar = sstep((T - 3.7) / 0.25) * (1 - sstep((T - 6.4) / 0.7))
        A.rear = 0.85 * roar
        A.jaw = roar * (0.9 + 0.1 * math.sin(t * 20))
        A.shiver = 1.2 * roar
    elseif nm == "roar" then
        local roar = sstep(T / 0.4) * (1 - sstep((T - 3.4) / 0.7))
        A.rear = 0.9 * roar
        A.jaw = roar * (0.9 + 0.1 * math.sin(t * 20))
        A.shiver = 1.2 * roar
    end
end
local function stepActions(dt, t)
    A.jaw, A.rear, A.shiver, A.tail = 0, 0, 0, 0
    stepAct2(dt, t)
    if G.laserOn then G.laserAge = G.laserAge + dt else G.laserAge = 0 end
    G.laserW = G.laserW + ((G.laserOn and 1 or 0) - G.laserW) * math.min(dt * (G.laserOn and 4 or 3), 1)
    local w = G.laserW
    if w > 0.002 then
        local age = G.laserAge
        local C, F, GL
        if G.laserOn then
            C, F, GL = sstep(age / 1.4), sstep((age - 1.5) / 0.5), sstep((age - 1.4) / 0.4)
        else
            C, F, GL = w, w, w
        end
        G.laserSpin = G.laserSpin + dt * (5 + 16 * F)
        A.laserE, A.laserC, A.laserF, A.glow = w, C, F, GL * w
        A.laserSpin = G.laserSpin
        A.jaw = math.max(A.jaw, sstep(age / 0.8) * w)
        A.rear = math.max(A.rear, 0.3 * F)
        A.shiver = math.max(A.shiver, 1.0 * F)
    end
end
local function beamPose(k, hf)
    local ang = A.laserSpin + k * (2 * math.pi / #LASER)
    local ring = 13 * (1 - 0.7 * A.laserC) * (1 - A.laserF)
    local z = -(HS + 22 + (k - 1) * 32 * A.laserF)
    return hf * CFrame.new(ring * math.cos(ang), HINGE.Y + ring * math.sin(ang), z) * CFrame.Angles(0, 0, ang)
end

