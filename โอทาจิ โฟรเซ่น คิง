local function registerProp(id, prop)
    clearSlot(id)
    PROP_CACHE[id] = prop
    LAST_SEND_TIME[id] = 0
    COLOR_SENDING[id] = false
    NETWORK_STATE[id] = false
    NETWORK_GEN[id] = 0
    COLOR_GEN[id] = 0
    COLOR_SEND_TIME[id] = 0
    task.spawn(function()
        task.wait(0.05)
        pcall(ensureScale, prop, id)
    end)
end
local function matchById(prop)
    local pid = prop:GetAttribute("id")
    if type(pid) ~= "string" then return nil end
    local sz = propSize(prop)
    local sc = propScale(prop) or 1
    local best, bestScore
    for i = 1, N do
        if not PROP_CACHE[i] and PROP_IDS[i] == pid then
            local score
            if sz then
                local e = EXTENTS[i]
                score = math.abs(sz.X - e.X) / e.X + math.abs(sz.Y - e.Y) / e.Y + math.abs(sz.Z - e.Z) / e.Z
            else
                score = math.abs(sc - PROP_SCALES[i]) / PROP_SCALES[i]
            end
            if not bestScore or score < bestScore then best, bestScore = i, score end
        end
    end
    return best
end
local function matchBySize(prop)
    local sz = propSize(prop)
    if not sz then return nil end
    for i = 1, N do
        if not PROP_CACHE[i] and sameSize(EXTENTS[i], sz) then return i end
    end
    return nil
