local function flatV(v) return Vector3.new(v.X, 0, v.Z) end
local function halfY(cf, e)
    return (math.abs(cf.RightVector.Y) * e.X + math.abs(cf.UpVector.Y) * e.Y + math.abs(cf.LookVector.Y) * e.Z) / 2
end

local EYES = (RAW[EYE_A].Position + RAW[EYE_B].Position) / 2
local AF, SPOS, S_MAX, BASE_Y = Vector3.new(0, 0, 1), {}, 1, 0
local OFFSETS, RISE_DELAY, FOLLOW_K = {}, {}, {}
local STAND_S, STAND_LOCAL, STAND_ID, STAND_REL = 0, Vector3.new(0, 25, 0), nil, Vector3.zero
local function refCF(s)
    local o = Vector3.new(EYES.X + AF.X * s, BASE_Y, EYES.Z + AF.Z * s)
    return CFrame.lookAt(o, o - AF)
end
do
    local cent = Vector3.zero
    for i = 1, N do cent = cent + RAW[i].Position end
    cent = cent / N
    local d = flatV(cent - EYES)
    if d.Magnitude > 0.01 then AF = d.Unit end

    S_MAX = 1
    for i = 1, N do
        SPOS[i] = flatV(RAW[i].Position - EYES):Dot(AF)
        if SPOS[i] > S_MAX then S_MAX = SPOS[i] end
    end

    local lo = math.huge
    for i = 1, N do
        if SPOS[i] > 25 and SPOS[i] < S_MAX * 0.8 then
            local b = RAW[i].Position.Y - halfY(RAW[i], EXTENTS[i])
            if b < lo then lo = b end
        end
    end
    if lo == math.huge then lo = EYES.Y - 20 end
    BASE_Y = lo

    for i = 1, N do
        OFFSETS[i] = refCF(SPOS[i]):Inverse() * RAW[i]
        local k = math.clamp(SPOS[i] / S_MAX, 0, 1)
        RISE_DELAY[i] = k * 1.4
        FOLLOW_K[i] = 50
    end

    STAND_ID = 25
    STAND_S = SPOS[STAND_ID]
    local restPt = RAW[STAND_ID].Position + Vector3.new(0, 4, 0)
