    local function makeDraggable(handle, target, ignoreBtns)
        local dragging, dragStart, dragPos = false, nil, nil
        local function inBtn(btn, mx, my)
            if not btn or not btn.Visible then return false end
            local p, s = btn.AbsolutePosition, btn.AbsoluteSize
            return mx >= p.X and mx <= p.X + s.X and my >= p.Y and my <= p.Y + s.Y
        end
        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local mx, my = input.Position.X, input.Position.Y
                for _, b in ipairs(ignoreBtns or {}) do if inBtn(b, mx, my) then return end end
                dragging, dragStart, dragPos = true, Vector2.new(mx, my), target.Position
            end
        end)
        track(UIS.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local dx, dy = input.Position.X - dragStart.X, input.Position.Y - dragStart.Y
            target.Position = UDim2.new(dragPos.X.Scale, dragPos.X.Offset + dx, dragPos.Y.Scale, dragPos.Y.Offset + dy)
        end))
        track(UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end))
    end

