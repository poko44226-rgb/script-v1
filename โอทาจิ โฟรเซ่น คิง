local STEP = 2
local MAXPTS = math.ceil((S_MAX + 90) / STEP)
local TRAIL = {}
local HEAD, HEAD_DIR, HEAD_SPEED = Vector3.zero, Vector3.new(0, 0, -1), 0
local d0, T0 = STEP, Vector3.new(0, 0, -1)
local groundTarget, groundYSmooth, lastGroundCalc = 0, 0, 0
local WAVE_K, WAVE_KV = 2 * math.pi / 110, 2 * math.pi / 90
local wavePh, wavePhV, shPh, ampL, ampV, shiver = 0, 0, 0, 0, 0, 0
local moveF, flyW = 0, 0
local sideFallback = Vector3.xAxis
local TURN_RATE = 2.4
local CSTEP, COL_MAX = 4, math.ceil((S_MAX + 90) / 4)

local function initTrail(pos, dir)
    local f = flatV(dir)
    if f.Magnitude < 0.01 then f = Vector3.new(0, 0, -1) else f = f.Unit end
    HEAD, HEAD_DIR, HEAD_SPEED = pos, f, 0
    TRAIL = {}
    for k = 1, MAXPTS do TRAIL[k] = pos - f * (k * STEP) end
    d0, T0 = STEP, f
    sideFallback = f:Cross(Vector3.yAxis)
    if sideFallback.Magnitude < 0.01 then sideFallback = Vector3.xAxis else sideFallback = sideFallback.Unit end
    G.fV, G.vel = Vector3.zero, Vector3.zero
end

local function pushHead(newPos)
    HEAD = newPos
    local guard = 0
    while guard < MAXPTS do
        guard = guard + 1
        local last = TRAIL[1]
        local d = HEAD - last
        local m = d.Magnitude
        if m < STEP then break end
        table.insert(TRAIL, 1, last + d.Unit * STEP)
        if #TRAIL > MAXPTS then table.remove(TRAIL) end
    end
end

local function shiftSerpent(delta)
    HEAD = HEAD + delta
    for k = 1, #TRAIL do TRAIL[k] = TRAIL[k] + delta end
    if G.fTarget then G.fTarget = G.fTarget + Vector3.new(delta.X, 0, delta.Z) end
end

local function posAt(s)
    if s <= 0 then return HEAD + T0 * (-s) end
    local n = #TRAIL
    if n == 0 then return HEAD - T0 * s end
    if s <= d0 then return HEAD:Lerp(TRAIL[1], s / math.max(d0, 1e-4)) end
    local idx = (s - d0) / STEP
    local i = math.floor(idx)
    local a, b = TRAIL[i + 1], TRAIL[i + 2]
    if not a then return TRAIL[n] end
    if not b then return a end
    return a:Lerp(b, idx - i)
end

local function prepFrames()
    d0 = TRAIL[1] and (HEAD - TRAIL[1]).Magnitude or STEP
    local d = HEAD - posAt(6)
    if d.Magnitude > 1e-3 then T0 = d.Unit else T0 = HEAD_DIR end
end

local frameAt
do
local COIL_R, COIL_START = 46, 34
local function smooth01(x) x = math.clamp(x, 0, 1) return x * x * (3 - 2 * x) end
local function bodyPos(s)
    local P = posAt(s)
    if A.tail > 0.001 then
        local wt = smooth01((s - S_MAX * 0.45) / (S_MAX * 0.45))
        if wt > 0 then
            local rad = Vector3.new(P.X - G.coilC.X, 0, P.Z - G.coilC.Z)
            if rad.Magnitude > 1e-3 then rad = rad.Unit else rad = Vector3.xAxis end
            P = P + (rad * 32 + Vector3.yAxis * 12) * (A.tail * wt)
        end
    end
    return P
end

frameAt = function(s)
    local sc = s > 0 and s or 0
    local P = bodyPos(s)
    local T = bodyPos(s - 8) - bodyPos(s + 8)
    if T.Magnitude > 1e-3 then T = T.Unit else T = T0 end
    local R = T:Cross(Vector3.yAxis)
    if R.Magnitude > 1e-3 then R = R.Unit sideFallback = R else R = sideFallback end
    local U = R:Cross(T)
    local k = math.clamp(sc / (S_MAX * 0.6), 0.05, 1)
    local aL = ampL * k
    local phL = wavePh - sc * WAVE_K
    P = P + R * (aL * math.sin(phL) + shiver * math.sin(shPh + sc * 0.3))
    T = T + R * (aL * WAVE_K * math.cos(phL))
    if ampV > 0.001 then
        local aV = ampV * k
        local phV = wavePhV - sc * WAVE_KV
        P = P + U * (aV * math.sin(phV))
        T = T + U * (aV * WAVE_KV * math.cos(phV))
    end
    if A.rear > 0.001 then
        local uu = math.clamp(sc / 60, 0, 1)
        P = P + Vector3.yAxis * (A.rear * 30 * (1 - uu) * (1 - uu))
        T = T + Vector3.yAxis * (A.rear * (1 - uu))
    end
    T = T.Unit
    return CFrame.lookAt(P, P + T, U)
end
end

