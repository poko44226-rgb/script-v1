track(RS.Heartbeat:Connect(function(dt)
    if not isAlive() or not petMode then return end
    local t = tick()
    if t - lastPropUpdate > 1 then
        lastPropUpdate = t
        UpdateAndValidateProps()
    end
    local total = PROP_COUNT
    if total < 1 then return end

    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if not snapNextFrame then stepHead(dt, t, hum) end
    prepFrames()

    moveF = moveF + (math.clamp(HEAD_SPEED / 18, 0, 1) - moveF) * math.min(dt * 5, 1)
    flyW = flyW + ((flyMode and 1 or 0) - flyW) * math.min(dt * 3, 1)
    local frozNow = 0
    if G.froz then
        local st = t - G.frozStart
        if st >= FROZ_DUR then
            G.froz = false
        else
            frozNow = math.clamp(st / 1.0, 0, 1) * (1 - math.clamp((st - 9.5) / 1.5, 0, 1))
            shiver = 0.35 * math.clamp((st - 4) / 1, 0, 1) * (1 - math.clamp((st - 9) / 0.8, 0, 1))
        end
    end
    if not G.froz then shiver = 0 end
    stepActions(dt, t)
    shiver = shiver + A.shiver
    shPh = shPh + dt * 45
    G.dampS = G.dampS + ((1 - frozNow) - G.dampS) * math.min(dt * 4, 1)
    wavePh = wavePh + dt * (2 + math.clamp(HEAD_SPEED / 20, 0, 5)) * G.dampS
    wavePhV = wavePhV + dt * (1.5 + math.clamp(HEAD_SPEED / 25, 0, 4)) * G.dampS
    ampL = (0.5 + 3.0 * moveF) * G.dampS * (1 - flyW)
    ampV = 0

    local lead = G.vel * math.clamp(estimatedPing * 1.6 + 0.03, 0.03, 0.25)
    if lead.Magnitude > 25 then lead = lead.Unit * 25 end
    G.lead = (G.lead or Vector3.zero):Lerp(lead, 1 - math.exp(-16 * dt))

    local since = t - summonStartTime
    local hf = frameAt(HS)
    local jw = A.jaw
    local chomp = flyW * math.clamp(moveF * 1.4, 0, 1) * (0.5 - 0.5 * math.cos(t * 2.3)) * 0.62
    if G.sndTick then G.sndTick(flyMode, moveF, G.laserOn) end
    if chomp > jw then jw = chomp end
    local upX, lowX = hingeCF(0.14 * jw), hingeCF(-0.55 * jw)
    for id = 1, total do
        local prop = PROP_CACHE[id]
        if prop and prop.Parent then
            local targetCF
            if HEAD_OFF[id] then
                targetCF = hf * (G_MOUTH_UP[id] and upX or (G_MOUTH_LOW[id] and lowX or IDENT)) * HEAD_OFF[id]
            else
                targetCF = frameAt(SPOS[id]) * OFFSETS[id]
                local li = LASER_IDX[id]
                if li and A.laserE > 0.001 then targetCF = targetCF:Lerp(beamPose(li, hf), A.laserE) end
            end
            local p = (since - RISE_DELAY[id]) / RISE_TIME
            if p < 1 then
                if p < 0 then p = 0 end
                local e = 1 - (1 - p) * (1 - p)
                targetCF = targetCF - Vector3.new(0, (1 - e) * RISE_DEPTH, 0)
            end
            local cur = CURRENT_CFRAMES[id]
            if snapNextFrame or not cur then
                CURRENT_CFRAMES[id] = targetCF
            else
                CURRENT_CFRAMES[id] = cur:Lerp(targetCF, 1 - math.exp(-FOLLOW_K[id] * dt))
            end
            local want = PROP_COLORS[id]
            if G.camo then want = camoAt(SPOS[id], want) end
            local pc = G.pcol[id] or want
            G.pcol[id] = pc:Lerp(want, 1 - math.exp(-10 * dt))
        end
    end
    snapNextFrame = false

    if G.pinned then
        local ready = since > (RISE_TIME + 1.6)
        if not flyMode then
            G.landT = G.landT + dt
            if (HEAD.Y - (groundYSmooth + HOVER)) < 1.5 or G.landT > 4 then releasePin() end
        end
        if G.pinned and ready then doPin() end
    end

    if estimatedPing > 0.15 then
        NETWORK_TICK_RATE = math.clamp(estimatedPing * 0.5, BASE_TICK_RATE, 0.08)
    else
        NETWORK_TICK_RATE = BASE_TICK_RATE
    end
    local chokeT = math.clamp(measuredPing * 2 + 0.04, MAX_CHOKE_TIMEOUT, 0.4)
    local busy = G.inflight > 0 and (t - G.batchT) < chokeT * 2
    if not busy and (t - G.batchT) >= NETWORK_TICK_RATE then
        local moved = false
        for id = 1, total do
            local cf = CURRENT_CFRAMES[id]
            if PROP_CACHE[id] and cf then
                local last = LAST_SENT_CF[id]
                if (not last) or ((cf.Position - last.Position).Magnitude
                    + ((cf.LookVector - last.LookVector).Magnitude + (cf.UpVector - last.UpVector).Magnitude) * 3) > DEADBAND_STUDS * 0.6 then
                    moved = true
                    break
                end
            end
        end
        if moved then
            G.batchId = G.batchId + 1
            G.inflight = 0
            G.batchT = t
            for id = 1, total do
                local prop, cf = PROP_CACHE[id], CURRENT_CFRAMES[id]
                if prop and cf then
                    local cfR = getRemotes(id, prop).cf
                    if cfR then
                        LAST_SENT_CF[id] = cf
                        G.inflight = G.inflight + 1
                        task.spawn(sendCF, id, G.batchId, cfR, cf + G.lead)
                    end
                end
            end
        end
    end

    if (t - lastColorUpdate) > 0.03 then
        lastColorUpdate = t
        local function trySend(id)
            local prop = PROP_CACHE[id]
            if COLOR_SENDING[id] and (t - (COLOR_SEND_TIME[id] or 0)) > 0.5 then COLOR_SENDING[id] = false end
            if prop and not COLOR_SENDING[id] then
                local want = desiredColor(id, t)
                local last = G.last[id]
                local diff = (not last) or (math.abs(want.R - last.R) + math.abs(want.G - last.G) + math.abs(want.B - last.B)) > 0.03
                if (COLOR_GEN[id] or 0) == 0 or diff or (t - (COLOR_SEND_TIME[id] or 0)) > 15 then
                    local crR = getRemotes(id, prop).color
                    if crR then
                        COLOR_SENDING[id] = true
                        COLOR_SEND_TIME[id] = t
                        G.last[id] = want
                        task.spawn(sendColor, id, crR, want)
                    end
                end
            end
        end
        trySend(11)
        trySend(12)
        for _ = 1, 4 do
            if colorIndex > total then colorIndex = 1 end
            trySend(colorIndex)
            colorIndex = (colorIndex % total) + 1
        end
    end
end))

