local SIZE_TOL = 0.15

local function propSize(prop)
    local ok, sz = pcall(function()
        if prop:IsA("Model") then return prop:GetExtentsSize() end
        if prop:IsA("BasePart") then return prop.Size end
        return nil
    end)
    if ok and typeof(sz) == "Vector3" then return sz end
    return nil
end
local function propScale(prop)
    if not prop:IsA("Model") then return nil end
    local ok, sc = pcall(function() return prop:GetScale() end)
    if ok and type(sc) == "number" and sc > 0 then return sc end
    return nil
end
local function sameSize(a, b)
    return math.abs(a.X - b.X) <= SIZE_TOL and math.abs(a.Y - b.Y) <= SIZE_TOL and math.abs(a.Z - b.Z) <= SIZE_TOL
end
local function ensureScale(prop, id)
    if not prop or not prop.Parent or not prop:IsA("Model") then return end
    local sz, want = propSize(prop), EXTENTS[id]
    if not sz or not want then return end
    local sm = math.max(sz.X, sz.Y, sz.Z)
    local wm = math.max(want.X, want.Y, want.Z)
    if sm <= 0 then return end
    local r = wm / sm
    if math.abs(r - 1) > 0.03 then
        local cur = propScale(prop) or 1
        pcall(function() prop:ScaleTo(cur * r) end)
    end
end
local function getRemotes(id, prop)
    local c = REMOTE_CACHE[id]
    if not c or c.prop ~= prop then
        c = { prop = prop, cf = nil, color = nil }
        REMOTE_CACHE[id] = c
        REMOTE_RETRY[id] = 0
    end
    if not (c.cf and c.color) then
        local now = tick()
        if now - REMOTE_RETRY[id] > 1 then
            REMOTE_RETRY[id] = now
            if not c.cf then
                local r = prop:FindFirstChild("SetCurrentCFrame")
                if r and r:IsA("RemoteFunction") then c.cf = r end
            end
            if not c.color then
                local r = prop:FindFirstChild("ChangePropColor")
                if r and r:IsA("RemoteFunction") then c.color = r end
            end
        end
    end
    return c
end
local function recalcPropCount()
