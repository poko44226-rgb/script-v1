    local function gtoggle(win, text, order, onToggle)
        local btn = gbtn(win, text, order)
        local st = { on = false, button = btn }
        function st.set(v)
            st.on = v and true or false
            btn:SetAttribute("on", st.on)
            tw(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = st.on and C.ON or C.BTN,
                BackgroundTransparency = 0,
                TextColor3 = st.on and C.ONTEXT or C.TEXT,
            })
        end
        btn.MouseButton1Click:Connect(function()
            st.set(not st.on)
            if onToggle then onToggle(st.on) end
        end)
        return st
    end

