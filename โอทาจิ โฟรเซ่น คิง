local FROZ_DUR = 13
local ICE_A, ICE_B = Color3.fromRGB(189, 244, 255), Color3.fromRGB(244, 252, 255)
local function iceCol(id) return ICE_A:Lerp(ICE_B, ((id * 37) % 28) / 28) end
local function frozAmount(id, st)
    local rk = math.clamp(SPOS[id], 0, S_MAX) / S_MAX
    local p = math.clamp((st - rk * 3.0) / 0.7, 0, 1)
    local q = math.clamp((st - 9.5 - rk * 2.0) / 0.8, 0, 1)
    return p * (1 - q)
end
local BZ_DEEP, BZ_MID, BZ_PALE = Color3.fromRGB(46, 120, 214), Color3.fromRGB(120, 214, 255), Color3.fromRGB(244, 252, 255)
local function blazeCol(id, t)
    local rk = math.clamp(SPOS[id], 0, S_MAX) / S_MAX
    local base
    if rk < 0.5 then base = BZ_DEEP:Lerp(BZ_MID, rk * 2) else base = BZ_MID:Lerp(BZ_PALE, (rk - 0.5) * 2) end
    local sh = 0.5 + 0.5 * math.sin(t * 1.6 - rk * 7)
    base = base:Lerp(BZ_PALE, sh * 0.35)
    local bt = t - G.breathT
    if bt >= 0 and bt < 3 then
        local d = math.abs(rk - bt / 2.2)
        local a = math.clamp(1 - d / 0.16, 0, 1)
        if a > 0 then base = base:Lerp(Color3.new(1, 1, 1), a) end
    end
    return base
end
local TM_PINK, TM_PURP, TM_BLACK = Color3.fromRGB(255, 45, 170), Color3.fromRGB(165, 60, 255), Color3.fromRGB(14, 8, 18)
local function tiamatCol(id, t)
    if G_BODY[id] or G_MOUTH_LOW[id] or (G_MOUTH_UP[id] and not G_EYES[id]) then return TM_BLACK end
    local rk = math.clamp(SPOS[id], 0, S_MAX) / S_MAX
    local w = 0.5 + 0.5 * math.sin(t * 1.8 - rk * 4 + id * 0.15)
    local c = TM_PINK:Lerp(TM_PURP, w)
    return c:Lerp(Color3.new(1, 1, 1), 0.12 * (0.5 + 0.5 * math.sin(t * 7 - rk * 9)))
end
local ATOM_A, ATOM_B = Color3.fromRGB(120, 215, 255), Color3.fromRGB(235, 250, 255)
local ATOM_PA, ATOM_PB = Color3.fromRGB(255, 50, 175), Color3.fromRGB(255, 170, 225)
local function desiredColor(id, t)
    local col = G.pcol[id] or PROP_COLORS[id]
    if G.tiamat then col = tiamatCol(id, t)
    elseif G.blaze then col = blazeCol(id, t)
    elseif t - G.breathT < 3 then
        local rk = math.clamp(SPOS[id], 0, S_MAX) / S_MAX
        local a = math.clamp(1 - math.abs(rk - (t - G.breathT) / 2.2) / 0.16, 0, 1)
        if a > 0 then col = col:Lerp(Color3.new(1, 1, 1), a) end
    end
    if G.froz then
        local a = frozAmount(id, t - G.frozStart)
        if a > 0 then col = col:Lerp(iceCol(id), a) end
    end
    local ca, cb = ATOM_A, ATOM_B
    if G.tiamat then ca, cb = ATOM_PA, ATOM_PB end
    if A.laserE > 0.02 and LASER_IDX[id] then
        col = col:Lerp(ca:Lerp(cb, 0.5 + 0.5 * math.sin(t * 14 + LASER_IDX[id])), A.laserE)
    elseif A.glow > 0.02 and (G_BODY[id] or G_SKIN[id] or G_TAIL[id]) then
        local rk = math.clamp(SPOS[id], 0, S_MAX) / S_MAX
        local g = math.clamp(math.sin(t * 9 - rk * 10) * 0.7 + 0.5, 0, 1) * A.glow
        col = col:Lerp(ca, g * 0.85)
    end
    if G_EYES[id] and flyMode and ((t * 1.7) % 1) < 0.2 then col = Color3.new(0, 0, 0) end
    return col
end

