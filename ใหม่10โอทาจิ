local function propInfo(prop)
    local id = prop:GetAttribute("ID") or prop:GetAttribute("id")
    local size = (prop:IsA("BasePart") and prop.Size) or (prop:IsA("Model") and prop:GetExtentsSize()) or nil
    return id, size
end

local function ScanForProps()
    local wc = workspace:FindFirstChild("WorkspaceCom")
    local folder = wc and wc:FindFirstChild("001_TrafficCones")
    if not folder then return end
    local mine = "Prop" .. OwnerName

    for i = 1, N do
        local p = slotProp[i]
        if p and not p.Parent then
            slotProp[i] = nil
            propSlot[p] = nil
            curCF[i] = nil
            bodyCF[i] = nil
        end
    end

    local fresh = {}
    for _, v in ipairs(folder:GetChildren()) do
        if v.Name == mine and not propSlot[v] then fresh[#fresh + 1] = v end
    end
    if #fresh == 0 then return end

    for pass = 1, 2 do
        for _, prop in ipairs(fresh) do
            if not propSlot[prop] then
                local id, size = propInfo(prop)
                if id then
                    for i = 1, N do
                        local d = D[i]
                        if not slotProp[i] and d.id == id
                            and (pass == 2 or (size and (size - d.size).Magnitude < 0.1)) then
                            slotProp[i] = prop
                            propSlot[prop] = i
                            break
                        end
                    end
                end
            end
        end
    end
end

-- ============================================================
-- SIZE (remote current size)
-- ============================================================
local function findSizeRemote(prop)
    local r = sizeRemote[prop]
    if r and r.Parent then return r end
    r = prop:FindFirstChild("SetCurrentSize") or prop:FindFirstChild("ChangePropSize") or prop:FindFirstChild("SetSize")
    if not r then
        for _, c in ipairs(prop:GetChildren()) do
            if (c:IsA("RemoteFunction") or c:IsA("RemoteEvent")) and c.Name:lower():find("size") then
                r = c
                break
            end
        end
    end
    sizeRemote[prop] = r
    return r
end

local function processSizes(now)
    if now - lastSizeTick < 0.06 then return end
    lastSizeTick = now
    local budget = 3
    for i = 1, N do
        local prop = slotProp[i]
        if prop and prop.Parent then
            local st = sizeState[prop]
            if not st then
                st = { ok = false, tries = 0, at = 0 }
                sizeState[prop] = st
            end
            if not st.ok then
                local want = D[i].size * (SizeScale[i] or 1)
                local _, cur = propInfo(prop)
                if cur and (cur - want).Magnitude < 0.15 then
                    st.ok = true
                elseif st.tries < 10 and now - st.at > 1.2 then
                    local r = findSizeRemote(prop)
                    if r then
                        st.at = now
                        st.tries += 1
                        budget -= 1
                        task.spawn(function()
                            pcall(function()
                                if r:IsA("RemoteFunction") then r:InvokeServer(want) else r:FireServer(want) end
                            end)
                        end)
                        if budget <= 0 then return end
                    end
                end
            end
        end
    end
end

