local function cfChanged(a, b)
    if not b then return true end
    if (a.Position - b.Position).Magnitude > POS_EPS then return true end
    return (a.LookVector - b.LookVector).Magnitude + (a.UpVector - b.UpVector).Magnitude > ROT_EPS
end

local function sendProp(prop, cf, now)
    if inFlight[prop] or (retryAt[prop] and now < retryAt[prop]) then return false end
    local remote = prop:FindFirstChild("SetCurrentCFrame")
    if not remote then return false end
    inFlight[prop] = true
    task.spawn(function()
        local ok = pcall(function() remote:InvokeServer(cf) end)
        inFlight[prop] = nil
        if ok then
            lastSentCF[prop] = cf
            lastSentT[prop] = tick()
        else
            retryAt[prop] = tick() + 0.75
        end
    end)
    return true
end

local function sendPositions(t, have)
    if t - lastSendTick < sendThreshold then return end
    lastSendTick = t
    local batch = math.clamp(math.ceil(have / 2), 12, 30)
    local sent, checked = 0, 0
    while sent < batch and checked < N do
        checked += 1
        if nextSendIndex > N then nextSendIndex = 1 end
        local i = nextSendIndex
        nextSendIndex += 1
        local prop, cf = slotProp[i], curCF[i]
        if prop and prop.Parent and cf then
            if cfChanged(cf, lastSentCF[prop]) or t - (lastSentT[prop] or 0) > FORCE_REFRESH then
                if sendProp(prop, cf, t) then sent += 1 end
            end
        end
    end
end

local function sendColors(t)
    if t - lastColorTick < 0.1 then return end
    lastColorTick = t
    local sent = 0
    for i = 1, N do
        local prop = slotProp[i]
        if prop and prop.Parent and sent < 8 then
            local want = colorForSlot(i)
            if colorSent[prop] ~= want and not colorBusy[prop] then
                local rem = prop:FindFirstChild("ChangePropColor")
                if rem then
                    colorBusy[prop] = true
                    sent += 1
                    task.spawn(function()
                        local ok = pcall(function() rem:InvokeServer(want) end)
                        colorBusy[prop] = nil
                        if ok then colorSent[prop] = want end
                    end)
                end
            end
        end
    end
end

-- ============================================================
-- HELPER MATH
-- ============================================================
local function smoothDamp(current, target, velocity, smoothTime, maxSpeed, dt)
    smoothTime = math.max(0.0001, smoothTime)
    local omega = 2 / smoothTime
    local x = omega * dt
    local e = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x)
    local change = current - target
    local origTarget = target
    local maxChange = maxSpeed * smoothTime
    if change.Magnitude > maxChange then change = change.Unit * maxChange end
    target = current - change
    local temp = (velocity + change * omega) * dt
    local newVel = (velocity - temp * omega) * e
    local output = target + (change + temp) * e
    if (origTarget - current):Dot(output - origTarget) > 0 then
        output = origTarget
        newVel = Vector3.zero
    end
    return output, newVel
end

-- rotasi minimal yang membawa arah a ke arah b (stabil, tanpa flip)
local function arcRot(a, b)
    local d = a:Dot(b)
    if d > 0.99999 then return CFrame.new() end
    if d < -0.99999 then
        local ax = a:Cross(Vector3.yAxis)
        if ax.Magnitude < 1e-3 then ax = a:Cross(Vector3.xAxis) end
        return CFrame.fromAxisAngle(ax.Unit, math.pi)
    end
    return CFrame.fromAxisAngle(a:Cross(b).Unit, math.acos(d))
end

-- putar menuju target dengan batas kecepatan sudut (anti muter mendadak)
local function rotateToward(cur, target, alpha, maxAng)
    local rel = cur:Inverse() * target
    local axis, ang = rel:ToAxisAngle()
    if ang < 1e-4 then return target end
    local step = math.min(ang * alpha, maxAng)
    return cur * CFrame.fromAxisAngle(axis, step)
end

local function flatRot(v, fallback)
    local f = Vector3.new(v.X, 0, v.Z)
    if f.Magnitude < 0.01 then return fallback end
    return CFrame.lookAt(Vector3.zero, f.Unit)
end

local function getTargetTorso(player)
    if not player or not player.Parent or not Players:FindFirstChild(player.Name) or not player.Character then return nil end
    local char = player.Character
    return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
end

local function FindNearestPrey()
    local nearest, shortest = nil, RAMPAGE_RADIUS
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and not rampageBlacklist[p.Name] then
            local char = p.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and not hum.Sit then
                    local torso = getTargetTorso(p)
                    if torso then
                        local dist = (LeviathanCurrentPos - torso.Position).Magnitude
                        if dist < shortest then
                            shortest = dist
                            nearest = p
                        end
                    end
                end
            end
        end
    end
    return nearest
end

