local function initChain(hf)
    local leader = hf:PointToWorldSpace(rearData)
    local rot = hf.Rotation
    for n = 1, TOTAL_SEG do
        local s = Seg[n]
        local d = rot:VectorToWorldSpace(s.out)
        local p = leader + d * (s.len * Cfg[n].spacing)
        baseDir[n] = d
        smDir[n] = d
        baseP[n] = p
        bodyCF[s.idx] = CFrame.new(p) * rot * s.rot
        leader = p
    end
    chainReady = true
end

