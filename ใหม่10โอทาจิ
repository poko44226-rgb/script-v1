local function refreshConfig()
    table.clear(SizeScale)
    for n = 1, TOTAL_SEG do
        local s = Seg[n]
        local f = (n - 0.5) / TOTAL_SEG
        local sec = SECTIONS[#SECTIONS]
        for _, sc in ipairs(SECTIONS) do
            if f <= sc.upTo then sec = sc break end
        end
        local ov = PropOverride[s.idx] or {}
        local rv = ov.rot or Vector3.zero
        Cfg[n] = {
            sec     = sec.name,
            amp     = sec.amp * (ov.wave or 1),
            smooth  = sec.smooth + (ov.delay or 0),
            lag     = sec.lag,
            pos     = ov.pos or Vector3.zero,
            rot     = CFrame.Angles(math.rad(rv.X), math.rad(rv.Y), math.rad(rv.Z)),
            spacing = ov.spacing or 1,
            scale   = ov.scale or 1,
        }
        if Cfg[n].scale ~= 1 then SizeScale[s.idx] = Cfg[n].scale end
    end
    table.clear(sizeState)
end
