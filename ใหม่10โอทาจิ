local lastStatus = ""
local function setStatus(txt, col)
    if txt ~= lastStatus then
        lastStatus = txt
        statusLabel.Text = txt
        statusLabel.TextColor3 = col
    end
end

track(RS.Heartbeat:Connect(function(dt)
    if not alive then return end
    dt = math.min(dt, 1 / 15)
    if not petMode then return end

    local t = tick()
    local pr = PRESETS[presetIdx]

    -- cek prop hilang / baru
    local needRescan = t - lastPropScanTime > 1.5
    if not needRescan and t - lastValidCheck > 0.25 then
        lastValidCheck = t
        for i = 1, N do
            local p = slotProp[i]
            if p and not p.Parent then needRescan = true break end
        end
    end
    if needRescan then
        lastPropScanTime = t
        ScanForProps()
    end

    local have = 0
    for i = 1, N do
        local p = slotProp[i]
        if p and p.Parent then have += 1 end
    end
    if have == 0 then
        setStatus("Otachi: NO PROPS", COLORS.WarningRed)
        return
    end

    if isFlinging then
        flingTimer = flingTimer - dt
        if flingTimer <= 0 then isFlinging = false end
    end

    if isFlinging then
        setStatus("Otachi: [TAIL STRIKE!]", COLORS.WarningRed)
    elseif isControlling then
        setStatus("Otachi: MANUAL", COLORS.Accent)
    elseif rampageMode then
        setStatus("Otachi: RAMPAGE", COLORS.Accent)
    else
        setStatus("Otachi: BASE P (" .. have .. "/" .. N .. ")", COLORS.Good)
    end

    -- ---------------- RAMPAGE LOGIC ----------------
    if rampageMode and not isControlling then
        if TargetPlayer then
            local ch = TargetPlayer.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            local torso = getTargetTorso(TargetPlayer)
            if not ch or not hum or hum.Health <= 0 or hum.Sit or rampageBlacklist[TargetPlayer.Name] or not Players:FindFirstChild(TargetPlayer.Name) then
                TargetPlayer = nil
            elseif torso then
                local vel = torso.AssemblyLinearVelocity.Magnitude
                local moved = (torso.Position - targetAttackTrack.initialPos).Magnitude
                if vel > 120 or moved > 85 then
                    rampageBlacklist[TargetPlayer.Name] = true
                    TargetPlayer = nil
                elseif t - targetAttackTrack.startTime > MAX_STUCK_TIME and moved < 8 then
                    rampageBlacklist[TargetPlayer.Name] = true
                    TargetPlayer = nil
                end
            end
        end

        if t - lastPreyScanTime > 0.35 then
            lastPreyScanTime = t
            if not TargetPlayer then
                local prey = FindNearestPrey()
                if prey then
                    TargetPlayer = prey
                    targetAttackTrack.player = prey
                    targetAttackTrack.startTime = t
                    local tt = getTargetTorso(prey)
                    if tt then targetAttackTrack.initialPos = tt.Position end
                    TargetBox.Text = "HUNT: " .. prey.DisplayName
                    TargetBox.BorderColor3 = COLORS.Accent
                else
                    TargetBox.Text = "[SCAN FAIL]"
                    TargetBox.BorderColor3 = COLORS.Border
                end
            end
        end
    end

    -- ---------------- ROTASI KEPALA (HEAD LOCK = TIDAK MUTER) ----------------
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local headRot
    if HEAD_LOCK then
        headRot = lockedRot
        freeRot = lockedRot
    else
        local desired = freeRot
        local tt = rampageMode and TargetPlayer and getTargetTorso(TargetPlayer)
        if isControlling and LeviathanCore then
            desired = flatRot(LeviathanCore.CFrame.LookVector, freeRot)
        elseif tt then
            desired = flatRot(tt.Position - LeviathanCurrentPos, freeRot)
        elseif root then
            desired = flatRot(root.CFrame.LookVector, freeRot)
        end
        freeRot = freeRot:Lerp(desired, 1 - math.exp(-pr.rot * dt))
        headRot = freeRot
    end

    -- ---------------- POSISI ORIGIN (BASE P = PLAYER) ----------------
    if isControlling and LeviathanCore and bodyVel then
        followVel = Vector3.zero
        LeviathanCurrentPos = LeviathanCore.Position + Vector3.new(0, math.sin(t * 1.8) * HOVER_SWAY, 0)
    else
        local isPetState = false
        local currentTarget = TargetPlayer
        if not rampageMode and (not currentTarget or not currentTarget.Character or not getTargetTorso(currentTarget)) then
            currentTarget = LP
            isPetState = true
        end
        local targetTorso = getTargetTorso(currentTarget)

        if targetTorso then
            local ideal
            if isPetState then
                local base = (root and root.Position) or targetTorso.Position
                ideal = base + headRot:VectorToWorldSpace(BASE_OFFSET) + Vector3.new(0, math.sin(t * 1.8) * HOVER_SWAY, 0)
            else
                local ox = math.cos(t * ORBIT_SPEED) * ORBIT_RADIUS
                local oz = math.sin(t * ORBIT_SPEED) * ORBIT_RADIUS
                local oy = math.sin(t * 2) * 5
                ideal = targetTorso.Position + Vector3.new(ox, oy + ORBIT_HEIGHT, oz)
            end

            if (ideal - LeviathanCurrentPos).Magnitude > 400 then
                LeviathanCurrentPos = ideal
                followVel = Vector3.zero
            else
                LeviathanCurrentPos, followVel = smoothDamp(
                    LeviathanCurrentPos, ideal, followVel,
                    (isPetState and PET_SMOOTH_TIME or RAMPAGE_SMOOTH_TIME) * pr.smooth,
                    isPetState and PET_MAX_SPEED or RAMPAGE_MAX_SPEED, dt)
            end
        end
    end

    local headFrame = CFrame.new(LeviathanCurrentPos) * headRot

    -- teleport -> rantai reset ke bentuk data
    local teleported = lastHeadPos and (headFrame.Position - lastHeadPos).Magnitude > 150
    local rawSpeed = 0
    if lastHeadPos and not teleported then
        rawSpeed = (headFrame.Position - lastHeadPos).Magnitude / math.max(dt, 1e-3)
    end
    lastHeadPos = headFrame.Position
    speedSm = speedSm + (rawSpeed - speedSm) * (1 - math.exp(-5 * dt))
    local moveF = math.clamp(speedSm / 30, 0, 1)

    if not chainReady or teleported then
        initChain(headFrame)
    end

    -- ================================================================
    -- DYNAMIC BODY CHAIN (rigid link, semua nyambung)
    -- ================================================================
    local anchor = headFrame:PointToWorldSpace(rearData)
    local upRef = headRot.UpVector

    -- 1) rantai FISIK: tiap ruas diseret oleh ruas di depannya (jarak dikunci persis)
    local restPull = math.clamp(REST_PULL * (1 - moveF * 0.85) * dt, 0, 1)
    local leaderB = anchor
    for n = 1, TOTAL_SEG do
        local s = Seg[n]
        local len = s.len * Cfg[n].spacing
        local v = baseP[n] - leaderB
        local rest = headRot:VectorToWorldSpace(s.out)
        local d
        if v.Magnitude > 1e-3 then d = v.Unit else d = rest end
        d = (d + (rest - d) * restPull)
        if d.Magnitude < 1e-3 then d = rest else d = d.Unit end
        local np = leaderB + d * len
        baseP[n] = np
        baseDir[n] = d
        leaderB = np
    end

    -- 2) gelombang / swirl ekor merambat kepala -> ekor (melingkar saat diam)
    if isFlinging then
        waveTime = waveTime + dt * WAVE_SPEED * 3
    else
        waveTime = waveTime + dt * WAVE_SPEED
    end
    waveStr = waveStr + ((waveOn and 1 or 0) - waveStr) * (1 - math.exp(-3 * dt))
    local idleMul = 1 - MOVE_DAMP * moveF
    local flingMul = isFlinging and 2.4 or 1.0

    local renderLeader = anchor
    for n = 1, TOTAL_SEG do
        local s = Seg[n]
        local cfg = Cfg[n]
        local len = s.len * cfg.spacing
        local bd = baseDir[n]

        local right = bd:Cross(upRef)
        if right.Magnitude < 0.2 then right = headRot.RightVector else right = right.Unit end
        local up2 = right:Cross(bd)

        local prog = n / TOTAL_SEG
        local amp = SWIRL_AMP * (prog ^ SWIRL_EXP) * cfg.amp * waveStr * idleMul * pr.wave * flingMul
        local ph = waveTime - n * WAVE_FREQ - cfg.lag
        local th = amp * math.cos(ph)
        local tv = amp * SWIRL_VERT * math.sin(ph)

        local want = bd + right * th + up2 * tv
        want = want.Unit

        local tau = 1 / pr.dir + cfg.smooth * pr.smooth
        local aDir = 1 - math.exp(-dt / tau)
        local cd = smDir[n] or want
        cd = cd + (want - cd) * aDir
        if cd.Magnitude < 1e-3 then cd = want else cd = cd.Unit end
        smDir[n] = cd

        local np = renderLeader + cd * len

        -- prop: posisi + rotasi stabil
        local o = cfg.pos
        local propPos = np + right * o.X + up2 * o.Y + cd * o.Z
        local refOut = headRot:VectorToWorldSpace(s.out)
